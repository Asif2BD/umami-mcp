# ---------------------------------------------------------------------------
# Required: which Umami instance to talk to.
# This is the ONLY host this server ever contacts.
# ---------------------------------------------------------------------------
UMAMI_URL=https://analytics.example.com

# ---------------------------------------------------------------------------
# Credentials. Self-hosted Umami has no API keys, so it needs a login.
# Use a dedicated Umami account rather than your personal admin login.
# ---------------------------------------------------------------------------
UMAMI_USERNAME=mcp-bot
UMAMI_PASSWORD=change-me

# Umami Cloud instead? Use an API key and omit the two lines above.
# UMAMI_API_KEY=

# ---------------------------------------------------------------------------
# Permissions. Start at "read" and only widen when you need to.
#   read   analytics and reports only (default)
#   write  + create and update websites and teams
#   admin  + user management
# ---------------------------------------------------------------------------
UMAMI_MCP_MODE=read

# Irreversible operations (delete website, reset data, delete user) stay
# hidden from the model unless this is explicitly true, even in admin mode.
UMAMI_MCP_ALLOW_DESTRUCTIVE=false

# ---------------------------------------------------------------------------
# Transport. "stdio" for a local client such as Claude Code or Claude Desktop.
# "http" to run it as a service; keep the bind address on loopback and reach it
# through an SSH tunnel unless you put an authenticating proxy in front.
# ---------------------------------------------------------------------------
UMAMI_MCP_TRANSPORT=stdio
UMAMI_MCP_HOST=127.0.0.1
UMAMI_MCP_PORT=3334

# Optional
# UMAMI_TEAM_ID=
# UMAMI_MCP_TIMEOUT_MS=30000
